# Copy to .env and fill in ONLY the free credentials you obtained yourself.
# The application reads nothing but the variables listed here. Never put cloud/billing credentials here.

# Contact address placed in the HTTP User-Agent (SEC EDGAR and good API manners require it)
OCO_CONTACT_EMAIL=

# Free EIA API key — register yourself at https://www.eia.gov/opendata/register.php (no payment, no plan)
EIA_API_KEY=

# Free NASA FIRMS MAP_KEY — request at https://firms.modaps.eosdis.nasa.gov/api/map_key/ (email only)
FIRMS_MAP_KEY=

# Free Copernicus Data Space Ecosystem *General User* login — https://dataspace.copernicus.eu/ -> Register.
# Used ONLY for raw Sentinel product downloads. Do NOT buy/activate processing units or paid extensions.
CDSE_USERNAME=
CDSE_PASSWORD=

# Optional: local storage location and budgets
# OCO_DATA_DIR=/path/to/data
# OCO_DISK_BUDGET_GB=20
# OCO_DOWNLOAD_BUDGET_GB=8

# Optional: name of a model ALREADY installed in a local Ollama server on 127.0.0.1:11434
# OCO_LOCAL_LLM_MODEL=
